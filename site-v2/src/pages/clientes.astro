---
import BaseLayout from '../layouts/BaseLayout.astro';
import ClientGrid from '../components/ClientGrid.astro';
import CtaPanel from '../components/CtaPanel.astro';
---

<BaseLayout
  title="Clientes"
  description="Conheça marcas e empresas que fazem parte da trajetória da Evolução Biológica em controle de vetores e pragas urbanas."
>
  <header class="page-hero">
    <div class="page-hero-inner container">
      <div>
        <ol class="breadcrumb" aria-label="Navegação estrutural">
          <li><a href="/">Início</a></li>
          <li aria-current="page">Clientes</li>
        </ol>
        <h1>Experiência construída em diferentes operações.</h1>
      </div>
      <p>Empresas de diferentes segmentos que fazem parte da trajetória da Evolução Biológica.</p>
    </div>
  </header>

  <section class="section section-soft" aria-labelledby="client-list-title">
    <div class="container">
      <div class="section-heading" data-reveal>
        <div>
          <span class="eyebrow">Clientes</span>
          <h2 id="client-list-title">Marcas em nossa trajetória.</h2>
        </div>
        <p>Atuação em ambientes comerciais, corporativos e operações com diferentes rotinas e necessidades.</p>
      </div>
      <ClientGrid />
    </div>
  </section>

  <CtaPanel
    title="Sua operação precisa de um plano de controle?"
    text="Informe o perfil da empresa e os sinais observados para receber uma orientação inicial."
  />
</BaseLayout>
