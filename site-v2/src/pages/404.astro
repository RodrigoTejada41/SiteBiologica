---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Página não encontrada" description="A página solicitada não foi encontrada." noindex>
  <section class="not-found container">
    <span class="eyebrow">Erro 404</span>
    <h1>Página não encontrada.</h1>
    <p>O endereço pode ter mudado ou não existir.</p>
    <a class="button button-primary" href="/">Voltar ao início</a>
  </section>
</BaseLayout>
