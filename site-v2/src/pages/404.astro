---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Página não encontrada" description="O endereço solicitado não está disponível." noindex>
  <section class="not-found container">
    <span class="eyebrow">Erro 404</span>
    <h1>Esta página não está disponível.</h1>
    <p>O endereço pode ter sido alterado. Volte à página inicial para continuar navegando.</p>
    <a class="button button-primary" href="/">Ir para a página inicial</a>
  </section>
</BaseLayout>
