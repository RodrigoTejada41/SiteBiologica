---
import { Image } from 'astro:assets';
import heroImage from '../assets/hero-v2.jpg';
import qualitySeal from '../assets/brand/selo-premio-quality-brasil.png';
import sanitizacaoImage from '../assets/services/img_sanitizacao.jpg';
import BaseLayout from '../layouts/BaseLayout.astro';
import ServiceCard from '../components/ServiceCard.astro';
import ClientGrid from '../components/ClientGrid.astro';
import CtaPanel from '../components/CtaPanel.astro';
import { company, services, whatsappUrl } from '../data/site';

const featuredServices = services.slice(0, 4);
const faqs = [
  {
    question: 'Como solicitar um orçamento?',
    answer: 'Envie uma mensagem pelo WhatsApp ou preencha o formulário de contato. Informe o tipo de ambiente, a localização e os sinais observados para facilitar a avaliação inicial.',
  },
  {
    question: 'A Evolução Biológica atende residências e empresas?',
    answer: 'Sim. Atendemos residências, condomínios, comércios e empresas com soluções definidas conforme o ambiente e a ocorrência identificada.',
  },
  {
    question: 'Qual serviço devo escolher?',
    answer: 'Não é necessário identificar a praga sozinho. Descreva os sinais e o ambiente para que a equipe indique o serviço mais adequado ao cenário.',
  },
  {
    question: 'Como funciona o atendimento?',
    answer: 'Primeiro entendemos o cenário e reunimos as informações necessárias. Depois orientamos o serviço, a preparação do ambiente e o agendamento.',
  },
  {
    question: 'Qual é o horário de atendimento?',
    answer: company.hours + '.',
  },
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((faq) => ({
    '@type': 'Question',
    name: faq.question,
    acceptedAnswer: { '@type': 'Answer', text: faq.answer },
  })),
};
---

<BaseLayout
  title={company.name}
  description="Controle de vetores e pragas urbanas em São Paulo para residências, condomínios e empresas. Solicite uma avaliação e orçamento sem compromisso."
>
  <section class="hero" aria-labelledby="hero-title">
    <div class="hero-content">
      <span class="eyebrow">Controle de vetores e pragas urbanas em São Paulo</span>
      <h1 id="hero-title">Precisão para cuidar do seu ambiente.</h1>
      <p class="hero-copy">
        Soluções para residências, condomínios e empresas, definidas conforme o ambiente e os sinais encontrados.
      </p>
      <div class="hero-actions">
        <a
          class="button button-light"
          href={whatsappUrl('Olá! Gostaria de solicitar um orçamento para controle de pragas.')}
          target="_blank"
          rel="noopener noreferrer"
        >
          Solicitar orçamento
          <span aria-hidden="true">→</span>
        </a>
        <a class="button button-outline-light" href="/servicos">Explorar serviços</a>
      </div>
      <p class="hero-note">Atendimento: {company.hours.toLowerCase()}.</p>
    </div>
    <div class="hero-media">
      <Image
        class="hero-image"
        src={heroImage}
        alt=""
        widths={[640, 960, 1280, 1693]}
        sizes="(max-width: 899px) 100vw, 55vw"
        loading="eager"
        fetchpriority="high"
      />
      <div class="hero-award">
        <Image
          class="hero-award-image"
          src={qualitySeal}
          alt="Selo Prêmio Quality Brasil"
          widths={[128, 192]}
          sizes="(max-width: 899px) 72px, 104px"
          loading="eager"
        />
        <span>Prêmio Quality Brasil</span>
      </div>
    </div>
  </section>

  <div class="trust-rail" aria-label="Perfis de atendimento">
    <div class="trust-rail-inner container-wide">
      <div class="trust-item">
        <span class="trust-number" aria-hidden="true">01</span>
        <p><strong>Soluções residenciais</strong><br />Cuidado alinhado à rotina do imóvel.</p>
      </div>
      <div class="trust-item">
        <span class="trust-number" aria-hidden="true">02</span>
        <p><strong>Proteção para empresas</strong><br />Planejamento conforme a operação.</p>
      </div>
      <div class="trust-item">
        <span class="trust-number" aria-hidden="true">03</span>
        <p><strong>Orientação desde o contato</strong><br />Informações claras antes do serviço.</p>
      </div>
    </div>
  </div>

  <section class="section" aria-labelledby="services-title">
    <div class="container">
      <div class="section-heading" data-reveal>
        <div>
          <span class="eyebrow">Serviços</span>
          <h2 id="services-title">O controle certo para cada cenário.</h2>
        </div>
        <div>
          <p>Cada serviço considera a ocorrência, as características do imóvel e a rotina de quem utiliza o espaço.</p>
          <a class="button button-link" href="/servicos">Ver todos os serviços →</a>
        </div>
      </div>
      <div class="services-grid">
        {featuredServices.map((service, index) => <ServiceCard service={service} index={index} />)}
      </div>
    </div>
  </section>

  <section id="sobre" class="section section-soft" aria-labelledby="about-title">
    <div class="container split-layout">
      <div class="split-media" data-reveal>
        <Image
          src={sanitizacaoImage}
          alt="Profissional da Evolução Biológica realizando aplicação técnica"
          widths={[520, 760, 1024]}
          sizes="(max-width: 899px) 100vw, 48vw"
          loading="lazy"
        />
      </div>
      <div class="split-copy" data-reveal>
        <span class="eyebrow">Evolução Biológica</span>
        <h2 id="about-title">Cada ambiente exige uma estratégia própria.</h2>
        <p>
          Entender os sinais, os acessos e a rotina do local permite orientar uma solução mais precisa e responsável.
        </p>
        <ul class="feature-list">
          <li><span><strong>Leitura do ambiente</strong><br />Análise dos sinais, acessos e pontos de maior atividade.</span></li>
          <li><span><strong>Plano direcionado</strong><br />Método definido conforme a ocorrência e a estrutura.</span></li>
          <li><span><strong>Orientação em cada etapa</strong><br />Preparação, execução e cuidados posteriores explicados com clareza.</span></li>
        </ul>
      </div>
    </div>
  </section>

  <section class="section section-dark" aria-labelledby="process-title">
    <div class="container">
      <div class="section-heading" data-reveal>
        <div>
          <span class="eyebrow">Como funciona</span>
          <h2 id="process-title">Um processo simples, do contato à execução.</h2>
        </div>
        <p>Você informa o cenário, recebe a orientação inicial e organiza o atendimento com mais clareza.</p>
      </div>
      <div class="process-grid">
        <article class="process-step" data-reveal>
          <h3>Descreva o cenário</h3>
          <p>Informe o ambiente, a localização e os sinais que chamaram sua atenção.</p>
        </article>
        <article class="process-step" data-reveal>
          <h3>Receba uma orientação inicial</h3>
          <p>A equipe avalia as informações e indica o serviço compatível com a necessidade.</p>
        </article>
        <article class="process-step" data-reveal>
          <h3>Agende com clareza</h3>
          <p>Com o escopo definido, você recebe as instruções de preparação e combina a execução.</p>
        </article>
      </div>
    </div>
  </section>

  <section class="section section-soft" aria-labelledby="clients-title">
    <div class="container">
      <div class="section-heading" data-reveal>
        <div>
          <span class="eyebrow">Clientes</span>
          <h2 id="clients-title">Experiência em diferentes operações.</h2>
        </div>
        <div>
          <p>Marcas de diferentes segmentos fazem parte da trajetória de atendimento da Evolução Biológica.</p>
          <a class="button button-link" href="/clientes">Ver clientes →</a>
        </div>
      </div>
      <ClientGrid limit={7} />
    </div>
  </section>

  <section class="section" aria-labelledby="faq-title">
    <div class="container">
      <div class="section-heading" data-reveal>
        <div>
          <span class="eyebrow">Dúvidas frequentes</span>
          <h2 id="faq-title">Respostas para decidir com mais segurança.</h2>
        </div>
        <p>Entenda como solicitar um orçamento, escolher o serviço e preparar as informações iniciais.</p>
      </div>
      <div class="faq-list">
        {faqs.map((faq) => (
          <details data-reveal>
            <summary>{faq.question}</summary>
            <p>{faq.answer}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <CtaPanel />
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
</BaseLayout>
