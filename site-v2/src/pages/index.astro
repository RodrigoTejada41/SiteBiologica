---
import { Image } from 'astro:assets';
import heroImage from '../assets/hero-v2.jpg';
import sanitizacaoImage from '../assets/services/img_sanitizacao.jpg';
import BaseLayout from '../layouts/BaseLayout.astro';
import ServiceCard from '../components/ServiceCard.astro';
import ClientGrid from '../components/ClientGrid.astro';
import CtaPanel from '../components/CtaPanel.astro';
import { company, services, whatsappUrl } from '../data/site';

const featuredServices = services.slice(0, 4);
const faqs = [
  {
    question: 'Como solicitar um orçamento?',
    answer: 'Envie uma mensagem pelo WhatsApp ou preencha o formulário de contato com o tipo de ambiente, a cidade e o problema encontrado. A equipe dará sequência ao atendimento.',
  },
  {
    question: 'A Evolução Biológica atende residências e empresas?',
    answer: 'Sim. Os serviços são apresentados para ambientes residenciais, comerciais, condomínios e empresas, conforme a necessidade identificada.',
  },
  {
    question: 'Qual serviço devo escolher?',
    answer: 'Se houver dúvida, descreva os sinais observados e o ambiente. A identificação correta do problema ajuda a orientar o serviço mais adequado.',
  },
  {
    question: 'Como funciona o atendimento?',
    answer: 'O processo começa pelo contato e entendimento do cenário, seguido pela orientação do serviço e pelo agendamento da execução.',
  },
  {
    question: 'Qual é o horário de atendimento?',
    answer: company.hours + '.',
  },
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((faq) => ({
    '@type': 'Question',
    name: faq.question,
    acceptedAnswer: { '@type': 'Answer', text: faq.answer },
  })),
};
---

<BaseLayout
  title={company.name}
  description="Controle de pragas para residências, comércios, condomínios e empresas em São Paulo. Solicite um orçamento com a Evolução Biológica."
>
  <section class="hero" aria-labelledby="hero-title">
    <div class="hero-content">
      <span class="eyebrow">Controle de pragas em São Paulo</span>
      <h1 id="hero-title">Agilidade e precisão no controle de pragas.</h1>
      <p class="hero-copy">
        Atendimento para residências, comércios e empresas, com avaliação da necessidade e orçamento sem compromisso.
      </p>
      <div class="hero-actions">
        <a
          class="button button-light"
          href={whatsappUrl('Olá! Gostaria de solicitar um orçamento para controle de pragas.')}
          target="_blank"
          rel="noopener noreferrer"
        >
          Solicitar orçamento
          <span aria-hidden="true">→</span>
        </a>
        <a class="button button-outline-light" href="/servicos">Conhecer serviços</a>
      </div>
      <p class="hero-note">Atendimento: {company.hours.toLowerCase()}.</p>
    </div>
    <div class="hero-media" aria-hidden="true">
      <Image
        src={heroImage}
        alt=""
        widths={[640, 960, 1280, 1693]}
        sizes="(max-width: 899px) 100vw, 55vw"
        loading="eager"
        fetchpriority="high"
      />
    </div>
  </section>

  <div class="trust-rail" aria-label="Perfis de atendimento">
    <div class="trust-rail-inner container-wide">
      <div class="trust-item">
        <span class="trust-number" aria-hidden="true">01</span>
        <p><strong>Atendimento residencial</strong><br />Soluções conforme o ambiente.</p>
      </div>
      <div class="trust-item">
        <span class="trust-number" aria-hidden="true">02</span>
        <p><strong>Soluções para empresas</strong><br />Comércios, condomínios e operações.</p>
      </div>
      <div class="trust-item">
        <span class="trust-number" aria-hidden="true">03</span>
        <p><strong>Contato direto</strong><br />Orçamento rápido pelo WhatsApp.</p>
      </div>
    </div>
  </div>

  <section class="section" aria-labelledby="services-title">
    <div class="container">
      <div class="section-heading" data-reveal>
        <div>
          <span class="eyebrow">Serviços</span>
          <h2 id="services-title">Soluções para diferentes ambientes.</h2>
        </div>
        <div>
          <p>Atuação orientada ao tipo de ocorrência, às características do imóvel e à rotina do local.</p>
          <a class="button button-link" href="/servicos">Ver todos os serviços →</a>
        </div>
      </div>
      <div class="services-grid">
        {featuredServices.map((service, index) => <ServiceCard service={service} index={index} />)}
      </div>
    </div>
  </section>

  <section id="sobre" class="section section-soft" aria-labelledby="about-title">
    <div class="container split-layout">
      <div class="split-media" data-reveal>
        <Image
          src={sanitizacaoImage}
          alt="Profissional da Evolução Biológica realizando aplicação técnica"
          widths={[520, 760, 1024]}
          sizes="(max-width: 899px) 100vw, 48vw"
          loading="lazy"
        />
      </div>
      <div class="split-copy" data-reveal>
        <span class="eyebrow">Evolução Biológica</span>
        <h2 id="about-title">Atendimento pensado para o seu ambiente.</h2>
        <p>
          Cada ocorrência exige leitura do local, identificação dos pontos críticos e orientação clara sobre o serviço recomendado.
        </p>
        <ul class="feature-list">
          <li><span><strong>Diagnóstico do cenário</strong><br />Entendimento do ambiente e dos sinais observados.</span></li>
          <li><span><strong>Solução direcionada</strong><br />Definição do atendimento conforme a necessidade.</span></li>
          <li><span><strong>Orientação objetiva</strong><br />Informações sobre preparação, execução e cuidados posteriores.</span></li>
        </ul>
      </div>
    </div>
  </section>

  <section class="section section-dark" aria-labelledby="process-title">
    <div class="container">
      <div class="section-heading" data-reveal>
        <div>
          <span class="eyebrow">Como funciona</span>
          <h2 id="process-title">Do primeiro contato ao atendimento.</h2>
        </div>
        <p>Um fluxo direto para entender o problema, orientar a solução e organizar a execução.</p>
      </div>
      <div class="process-grid">
        <article class="process-step" data-reveal>
          <h3>Conte o que está acontecendo</h3>
          <p>Informe o tipo de ambiente, a cidade e os sinais encontrados.</p>
        </article>
        <article class="process-step" data-reveal>
          <h3>Receba a orientação</h3>
          <p>A equipe identifica o serviço aplicável e os dados necessários para o orçamento.</p>
        </article>
        <article class="process-step" data-reveal>
          <h3>Organize o atendimento</h3>
          <p>Com o escopo definido, o serviço é agendado conforme a disponibilidade.</p>
        </article>
      </div>
    </div>
  </section>

  <section class="section section-soft" aria-labelledby="clients-title">
    <div class="container">
      <div class="section-heading" data-reveal>
        <div>
          <span class="eyebrow">Clientes</span>
          <h2 id="clients-title">Marcas presentes em nossa trajetória.</h2>
        </div>
        <div>
          <p>Atendimento também voltado a operações comerciais e empresariais com diferentes necessidades.</p>
          <a class="button button-link" href="/clientes">Conhecer clientes →</a>
        </div>
      </div>
      <ClientGrid limit={7} />
    </div>
  </section>

  <section class="section" aria-labelledby="faq-title">
    <div class="container">
      <div class="section-heading" data-reveal>
        <div>
          <span class="eyebrow">Dúvidas frequentes</span>
          <h2 id="faq-title">Informação clara antes do contato.</h2>
        </div>
        <p>As orientações específicas variam conforme o ambiente e o tipo de ocorrência.</p>
      </div>
      <div class="faq-list">
        {faqs.map((faq) => (
          <details data-reveal>
            <summary>{faq.question}</summary>
            <p>{faq.answer}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <CtaPanel />
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
</BaseLayout>
