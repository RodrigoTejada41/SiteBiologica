---
import { Image } from 'astro:assets';
import qualitySeal from '../assets/brand/selo-premio-quality-brasil.png';
import { company, mapsUrl, whatsappUrl } from '../data/site';
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container footer-grid">
    <div class="footer-brand">
      <div class="footer-brand-marks">
        <img
          class="footer-logo"
          src="/images/logo.svg"
          alt={company.legalLabel}
          width="351"
          height="108"
          loading="lazy"
        />
        <Image
          class="footer-seal"
          src={qualitySeal}
          alt="Selo Prêmio Quality Brasil"
          widths={[96, 160]}
          sizes="80px"
          loading="lazy"
        />
      </div>
      <p>Soluções técnicas para controle de vetores e pragas urbanas em residências, condomínios e empresas.</p>
    </div>

    <div>
      <h2>Atendimento</h2>
      <p>{company.hours}</p>
      <address>
        {company.address.street}<br />
        CEP {company.address.postalCode} — {company.address.city}/{company.address.region}
      </address>
      <a href={mapsUrl} target="_blank" rel="noopener noreferrer">Como chegar</a>
      <a href={whatsappUrl('Olá! Gostaria de solicitar um orçamento.')} target="_blank" rel="noopener noreferrer">
        WhatsApp {company.whatsappDisplay}
      </a>
      {company.phones.map((phone) => <a href={phone.href}>{phone.display}</a>)}
      <a href={`mailto:${company.email}`}>{company.email}</a>
    </div>

    <div>
      <h2>Navegação</h2>
      <a href="/servicos">Serviços</a>
      <a href="/clientes">Clientes</a>
      <a href="/contato">Contato</a>
      <a href="/politica-de-privacidade">Política de privacidade</a>
    </div>
  </div>
  <div class="footer-bottom container">
    <p>© {year} {company.name}. Todos os direitos reservados.</p>
    <p>Atendimento em {company.region}.</p>
  </div>
</footer>

<a
  class="mobile-contact-bar"
  data-mobile-contact
  href={whatsappUrl('Olá! Gostaria de solicitar um orçamento.')}
  target="_blank"
  rel="noopener noreferrer"
  aria-label={`Solicitar orçamento pelo WhatsApp ${company.whatsappDisplay}`}
>
  <span aria-hidden="true">●</span>
  Solicitar pelo WhatsApp
</a>

<script>
  const contactBar = document.querySelector('[data-mobile-contact]');
  const updateContactBar = () => contactBar?.toggleAttribute('data-visible', window.scrollY > 420);
  updateContactBar();
  window.addEventListener('scroll', updateContactBar, { passive: true });
</script>
