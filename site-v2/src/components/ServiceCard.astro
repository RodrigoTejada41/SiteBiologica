---
import { Image } from 'astro:assets';
import type { Service } from '../data/site';

type Props = {
  service: Service;
  index: number;
};

const { service, index } = Astro.props;
---

<a
  class="service-card"
  href={`/servicos/${service.slug}`}
  aria-label={`Ver detalhes sobre ${service.name}`}
  data-reveal
>
  <div class="service-card-media">
    <Image
      src={service.image}
      alt={service.imageAlt}
      widths={[360, 520, 720]}
      sizes="(max-width: 620px) 100vw, (max-width: 1100px) 50vw, 25vw"
      loading="lazy"
    />
  </div>
  <div class="service-card-body">
    <span class="service-index">{String(index + 1).padStart(2, '0')}</span>
    <h3>{service.name}</h3>
    <p>{service.short}</p>
    <span class="card-link" aria-hidden="true">Ver detalhes <span>→</span></span>
  </div>
</a>
